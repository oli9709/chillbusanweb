{
  "name": "web-3",
  "version": "1.0.0",
  "description": "Modern, responsive website for Chill Busan Tours featuring tour packages, gallery, and booking system.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oli9709/chillbusanweb.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/oli9709/chillbusanweb/issues"
  },
  "homepage": "https://github.com/oli9709/chillbusanweb#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@sentry/node": "^7.91.0",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.17.2",
    "stripe": "^20.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "extensionsToTreatAsEsm": [".js"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": ["**/__tests__/**/*.test.js", "**/?(*.)+(spec|test).js"],
    "collectCoverageFrom": [
      "api/**/*.js",
      "utils/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/"
    ]
  }
}
